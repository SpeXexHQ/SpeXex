{
  "name": "spexex-electron",
  "version": "2.7.0-beta.0",
  "private": true,
  "description": "Electron wrapper for SpeXex, the static SpaceXpanse ROD wallet",
  "license": "Apache-2.0",
  "author": {
    "name": "SpaceXpanse",
    "email": "contact@spacexpanse.org"
  },
  "homepage": "https://www.spacexpanse.org/",
  "main": "src/main.js",
  "scripts": {
    "sync-wallet": "node scripts/sync-wallet.js",
    "test:smoke": "npm run sync-wallet && node scripts/smoke-test.js",
    "start": "npm run start:win",
    "start:win": "npm run sync-wallet && cmd /d /s /c \"set ELECTRON_RUN_AS_NODE=&& electron .\"",
    "start:linux": "npm run sync-wallet && ELECTRON_RUN_AS_NODE= electron .",
    "start:mac": "npm run sync-wallet && ELECTRON_RUN_AS_NODE= electron .",
    "pack": "npm run sync-wallet && electron-builder --publish never",
    "package:dir": "npm run sync-wallet && electron-builder --dir --publish never",
    "package:win": "npm run sync-wallet && electron-builder --win nsis dir --publish never",
    "package:linux": "npm run sync-wallet && electron-builder --linux AppImage deb --publish never",
    "package:mac": "npm run sync-wallet && electron-builder --mac dir zip dmg --publish never",
    "package:all": "npm run sync-wallet && electron-builder -mwl --publish never"
  },
  "overrides": {
    "@noble/hashes": "1.8.0",
    "app-builder-lib": {
      "@noble/hashes": "1.8.0"
    }
  },
  "build": {
    "appId": "org.spacexpanse.spexex",
    "productName": "SpeXex",
    "copyright": "Copyright © 2026 SpaceXpanse",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "app/wallet/**/*",
      "package.json",
      "!dist{,/**/*}",
      "!scripts{,/**/*}",
      "!node_modules/.cache{,/**/*}"
    ],
    "extraMetadata": {
      "main": "src/main.js"
    },
    "extraResources": [
      {
        "from": "../tools/rod-rpc-cors-proxy.js",
        "to": "bin/rod-rpc-cors-proxy.js"
      }
    ],
    "asar": true,
    "fileAssociations": [],
    "protocols": [],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "category": "Utility",
      "maintainer": "SpaceXpanse <contact@spacexpanse.org>",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "category": "public.app-category.finance",
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    }
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  }
}
